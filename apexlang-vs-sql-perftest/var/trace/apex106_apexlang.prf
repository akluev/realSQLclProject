  WORKING_COPY_CREATED_ON, WORKING_COPY_CREATED_BY, WORKING_COPY_NAME, 
  WORKING_COPY_DESCRIPTION, TASK_VACATION_RULE_PROCEDURE, AI_REMOTE_SERVER_ID,
