      c.secondary_static_id || chr(2) ||  p1.secondary_static_id as 
  secondary_static_ids,       c.page_id,(select t.static_id   from 
  wwv_flow_themes t where t.theme_id =  p1.theme_id   and t.flow_id  =  
  p1.flow_id   and t.security_group_id =  p1.security_group_id) as 
  theme_static_id,       c.flow_id  from ( select id,"APEXLANG_NAME" as 
  static_id,null as secondary_static_id,null as page_id,null as theme_id,     
    flow_id,       security_group_id,"PLUGIN_ID" as parent_fk_col  from 
  "WWV_FLOW_PLUGIN_SLOTS" tbl where security_group_id in ( :security_group_id,
   11, 12 ) and "FLOW_ID" = :FLOW_ID ) c, ( select "ID" as pk_column,
  "PLUGIN_TYPE" as static_id, "APEXLANG_NAME" as secondary_static_id,
  "FLOW_ID" as parent_fk_col,theme_id as theme_id,   flow_id,    
  security_group_id from "WWV_FLOW_PLUGINS_V" )  p1 where  p1.pk_column =  
  c.parent_fk_col and  p1.flow_id =  c.flow_id and  p1.security_group_id =  
  c.security_group_id)


