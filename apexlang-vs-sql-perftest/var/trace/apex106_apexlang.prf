select id,       static_ids,       case when replace( secondary_static_ids, 
  chr(2) ) is not null then           secondary_static_ids       end as 
  secondary_static_ids,       page_id,       theme_static_id,       flow_id  
from
 (select c.id,       c.static_id  || chr(2) ||  p1.static_id as static_ids,   
      c.secondary_static_id || chr(2) ||  p1.secondary_static_id as 
  secondary_static_ids,       c.page_id,null as theme_static_id,       
  c.flow_id  from ( select id,"STATIC_ID" as static_id,null as 
  secondary_static_id,"PAGE_ID" as page_id,null as theme_id,       flow_id,   
      security_group_id,"BUTTON_ID" as parent_fk_col  from 
  "WWV_FLOW_COMP_MENU_ENTRIES" tbl where security_group_id in ( 
  :security_group_id, 11, 12 ) and "FLOW_ID" = :FLOW_ID and button_id is not 
  null ) c, ( select "ID" as pk_column,"STATIC_ID" as static_id, null as 
  secondary_static_id,"FLOW_STEP_ID" as parent_fk_col,null as theme_id,   
  flow_id,    security_group_id from "WWV_FLOW_STEP_BUTTONS" )  p1 where  
  p1.pk_column =  c.parent_fk_col and  p1.flow_id =  c.flow_id and  
  p1.security_group_id =  c.security_group_id)


