  as static_id, null as secondary_static_id,"DOCUMENT_SOURCE_ID" as 
  parent_fk_col,null as theme_id,   flow_id,    security_group_id from 
  "WWV_FLOW_DATA_PROFILES_V" )  p1, ( select "ID" as pk_column,"STATIC_ID" as 
  static_id, null as secondary_static_id,"FLOW_ID" as parent_fk_col,null as 
  theme_id,   flow_id,    security_group_id from "WWV_FLOW_JSON_SOURCES" )  
  p2 where  p1.pk_column =  c.parent_fk_col and  p1.flow_id =  c.flow_id and  
