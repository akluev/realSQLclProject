wwv_flow_imp_page.create_page( 
p_id => 1, 
p_name => 'Home', 
p_alias => 'HOME', 
p_step_title => 'EMP & DEPT Mini Hub', 
p_page_mode => 'NORMAL', 
p_step_template => wwv_imp_util.get_reference_id(2510,wwv_flow_t_varchar2('standard'),null,null,'universal-theme',null,8842.242), 
p_page_template_options => '#DEFAULT#', 
p_overwrite_navigation_list => 'N', 
p_first_item => 'NO_FIRST_ITEM', 
p_warn_on_unsaved_changes => 'Y', 
p_inline_css => wwv_flow_string.join(wwv_flow_t_varchar2(
'/* =============================================',
unistr('   Department Hub \2014 Page CSS'),
unistr('   Page \2192 CSS \2192 Inline'),
'   ============================================= */',
'',
'/* Department Cards Grid */',
'.dept-cards-grid {',
'  display: grid;',
'  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));',
'  gap: 24px;',
'  padding: 16px;',
'}',
'',
'@media (max-width: 767px) {',
'  .dept-cards-grid {',
'    grid-template-columns: 1fr;',
'    gap: 16px;',
'  }',
'}',
'',
'/* Card container */',
'.dept-card {',
'  background: var(--ut-component-background-color);',
'  border-radius: 12px;',
'  overflow: hidden;',
'  box-shadow: var(--ut-shadow-md);',
'  transition: transform 0.2s, box-shadow 0.2s;',
'  cursor: pointer;',
'}',
'',
'.dept-card:hover {',
'  transform: translateY(-4px);',
'  box-shadow: var(--ut-shadow-lg);',
'}',
'',
'/* Card header */',
'.dept-card-header {',
'  position: relative;',
'  padding: 24px 24px 16px 24px;',
'  border-bottom: 1px solid var(--ut-component-border-color);',
'}',
'',
unistr('/* Colored background layer \2014 pale tint from color_class */'),
'.dept-card-header-bg {',
'  position: absolute;',
'  inset: 0;',
'  z-index: 0;',
'}',
'',
'/* All header content sits above background layer */',
'.dept-card-icon,',
'.dept-card-title,',
'.dept-card-location {',
'  position: relative;',
'  z-index: 1;',
'}',
'',
'.dept-card-icon {',
'  margin-bottom: 12px;',
'  display: inline-block;',
'}',
'',
'.dept-card-title {',
'  font-size: 22px;',
'  font-weight: 600;',
'  margin: 0 0 8px 0;',
'  color: var(--ut-component-text-title-color);',
'}',
'',
'.dept-card-location {',
'  font-size: 13px;',
'  color: var(--ut-component-text-muted-color);',
'  display: flex;',
'  align-items: center;',
'  gap: 6px;',
'}',
'',
unistr('/* Card body \2014 stat rows */'),
'.dept-card-body {',
'  padding: 4px 24px;',
'}',
'',
'.dept-stat-row {',
'  display: flex;',
'  justify-content: space-between;',
'  align-items: center;',
'  padding: 12px 0;',
'  border-bottom: 1px solid var(--ut-component-inner-border-color);',
'}',
'',
'.dept-stat-row:last-child {',
'  border-bottom: none;',
'}',
'',
'.dept-stat-label {',
'  font-size: 13px;',
'  color: var(--ut-component-text-muted-color);',
'  font-weight: 500;',
'  display: flex;',
'  align-items: center;',
'  gap: 8px;',
'}',
'',
'.dept-stat-value {',
'  font-size: 15px;',
'  font-weight: 600;',
'  color: var(--ut-component-text-title-color);',
'}',
'',
'/* Card footer */',
'.dept-card-footer {',
'  padding: 14px 24px;',
'  background: var(--ut-component-toolbar-background-color);',
'  display: flex;',
'  justify-content: space-between;',
'  align-items: center;',
'  gap: 12px;',
'}',
'',
'.city-fact {',
'  font-size: 12px;',
'  color: var(--ut-component-text-subtitle-color);',
'  font-style: italic;',
'  display: flex;',
'  align-items: center;',
'  gap: 6px;',
'  flex: 1;',
'  overflow: hidden;',
'  white-space: nowrap;',
'  text-overflow: ellipsis;',
'}')), 
p_page_is_public_y_n => 'N', 
p_protection_level => 'C', 
p_autocomplete_on_off => 'OFF', 
p_allow_duplicate_submissions => 'Y', 
p_reload_on_submit => 'S', 
p_cache_mode => 'NOCACHE' );
l_source := 'pages/p00001-home.apx:153:4:region';
wwv_flow_imp_page.create_page_plug( p_id=>wwv_imp_util.create_id(5110,wwv_flow_t_varchar2('departments'),null,wwv_flow_imp_page.current_page_id,null),p_page_id=>wwv_flow_imp_page.current_page_id,
p_plug_name => 'Departments', 
p_plug_source_type => 'NATIVE_CARDS', 
p_apexlang_location => 'LOCAL', 
p_query_type => 'SQL', 
p_plug_source => wwv_flow_string.join(wwv_flow_t_varchar2(
'select d.deptno,',
'       d.dname,',
'       d.loc,',
'       d.icon_class,',
'       d.color_class,',
'       -- Employee metrics',
'       count(e.empno) as emp_count,',
'       round(avg(e.sal), 0) as avg_salary,',
'       max(e.sal) as max_salary,',
'       min(e.sal) as min_salary,',
'       -- Manager info',
'       (select ename from emp where empno = ',
'         (select min(mgr) from emp where deptno = d.deptno)) as dept_manager,',
'       -- Job diversity',
'       count(distinct e.job_id) as unique_jobs,',
'       -- Location attributes (hardcoded city facts)',
'       case d.loc',
'         when ''NEW YORK'' then ''Financial capital of the world''',
'         when ''DALLAS'' then ''Growing tech and business hub''',
'         when ''CHICAGO'' then ''Major trading and commerce center''',
'         when ''BOSTON'' then ''Education and innovation leader''',
'         else ''Dynamic business location''',
'       end as city_fact,',
'       case d.loc',
'         when ''NEW YORK'' then ''fa-city''',
'         when ''DALLAS'' then ''fa-rocket''',
'         when ''CHICAGO'' then ''fa-chart-line''',
'         when ''BOSTON'' then ''fa-graduation-cap''',
'         else ''fa-map-marker''',
'       end as city_icon,',
'       -- Detail page link',
'       apex_page.get_url(',
'         p_page => 7,',
'         p_items => ''P7_DEPTNO'',',
'         p_values => d.deptno',
'       ) as detail_url',
'  from dept d',
'  left join emp e on d.deptno = e.deptno',
' group by d.deptno, d.dname, d.loc, d.icon_class, d.color_class',
' order by d.deptno')), 
p_plug_display_sequence => 10, 
p_plug_display_point => 'BODY', 
p_plug_new_grid => false, 
p_plug_new_grid_row => true, 
p_plug_template => wwv_imp_util.get_reference_id(2540,wwv_flow_t_varchar2('cards-container'),null,null,'universal-theme',null,8842.242), 
p_region_template_options => 't-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc', 
p_plug_item_display_point => 'ABOVE', 
p_use_landmark => true, 
p_static_id => 'departments', 
p_include_in_reg_disp_sel_yn => 'N', 
p_translate_title => case when 'N' = 'Y' then 'N' else 'Y' end, 
p_plug_customized => '0' );
