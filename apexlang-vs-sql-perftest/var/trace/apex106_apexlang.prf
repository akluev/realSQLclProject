select id,       static_ids,       case when replace( secondary_static_ids, chr(2) ) is not null then           secondary_static_ids       end as secondary_static_ids,       page_id,       theme_static_id,       flow_id  from (select c.id,       c.static_id  || chr(2) ||  p1.static_id || chr(2) ||  p2.static_id || chr(2) ||  p3.static_id as static_ids,       c.secondary_static_id || chr(2) ||  p1.secondary_static_id || chr(2) ||  p2.secondary_static_id || chr(2) ||  p3.secondary_static_id as secondary_static_ids,       c.page_id,null as theme_static_id,       c.flow_id  from ( select id,"STATIC_ID" as static_id,null as secondary_static_id,"PAGE_ID" as page_id,null as theme_id,       flow_id,       security_group_id,"REPORT_ID" as parent_fk_col  from "WWV_FLOW_IG_REPORT_CHART_V" tbl where security_group_id in ( :security_group_id, 11, 12 ) and "FLOW_ID" = :FLOW_ID and exists ( select 1
                      from wwv_flow_ig_reports r
                     where r.id   =  report_id
                       and r.type in ( 'PRIMARY', 'ALTERNATIVE' )
                       and r.session_id is null ) ) c, ( select "ID" as pk_column,"STATIC_ID" as static_id, null as secondary_static_id,"INTERACTIVE_GRID_ID" as parent_fk_col,null as theme_id,   flow_id,    security_group_id from "WWV_FLOW_IG_REPORTS_V" )  p1, ( select "ID" as pk_column,"STATIC_ID" as static_id, null as secondary_static_id,"REGION_ID" as parent_fk_col,null as theme_id,   flow_id,    security_group_id from "WWV_FLOW_INTERACTIVE_GRIDS_V" )  p2, ( select "ID" as pk_column,"STATIC_ID" as static_id, null as secondary_static_id,"PAGE_ID" as parent_fk_col,null as theme_id,   flow_id,    security_group_id from "WWV_FLOW_PAGE_PLUGS_V" )  p3 where  p1.pk_column =  c.parent_fk_col and  p1.flow_id =  c.flow_id and  p1.security_group_id =  c.security_group_id and  p2.pk_column =  p1.parent_fk_col and  p2.flow_id =  p1.flow_id and  p2.security_group_id =  p1.security_group_id and  p3.pk_column =  p2.parent_fk_col and  p3.flow_id =  p2.flow_id and  p3.security_group_id =  p2.security_group_id)

