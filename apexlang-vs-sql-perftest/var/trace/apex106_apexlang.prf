  secondary_static_id,"PAGE_ID" as parent_fk_col,null as theme_id,   flow_id, 
     security_group_id from "WWV_FLOW_PAGE_PLUGS_V" )  p2 where  p1.pk_column 
  =  c.parent_fk_col and  p1.flow_id =  c.flow_id and  p1.security_group_id = 
