FROM
 ( SELECT :B3 AS COMPONENT_TYPE_ID, TC.STATIC_ID AS STATIC_IDS, TO_CHAR(NULL) 
  AS SECONDARY_STATIC_IDS, TC.ID FROM WWV_FLOW_BUTTON_TEMPLATES TC WHERE 
  TC.FLOW_ID = :B2 AND TC.SECURITY_GROUP_ID IN ( :B1 , 11, 12 ) UNION ALL 
  SELECT :B4 , TC.STATIC_ID AS STATIC_IDS, TO_CHAR(NULL) AS 
  SECONDARY_STATIC_IDS, TC.ID FROM WWV_FLOW_CAL_TEMPLATES TC WHERE TC.FLOW_ID 
  = :B2 AND TC.SECURITY_GROUP_ID IN ( :B1 , 11, 12 ) UNION ALL SELECT :B5 , 
  TC.STATIC_ID AS STATIC_IDS, TO_CHAR(NULL) AS SECONDARY_STATIC_IDS, TC.ID 
  FROM WWV_FLOW_FIELD_TEMPLATES TC WHERE TC.FLOW_ID = :B2 AND 
  TC.SECURITY_GROUP_ID IN ( :B1 , 11, 12 ) UNION ALL SELECT :B6 , 
  TC.STATIC_ID AS STATIC_IDS, TO_CHAR(NULL) AS SECONDARY_STATIC_IDS, TC.ID 
  FROM WWV_FLOW_LIST_TEMPLATES TC WHERE TC.FLOW_ID = :B2 AND 
  TC.SECURITY_GROUP_ID IN ( :B1 , 11, 12 ) UNION ALL SELECT :B7 , 
  TC.STATIC_ID AS STATIC_IDS, TO_CHAR(NULL) AS SECONDARY_STATIC_IDS, TC.ID 
  FROM WWV_FLOW_MENU_TEMPLATES TC WHERE TC.FLOW_ID = :B2 AND 
  TC.SECURITY_GROUP_ID IN ( :B1 , 11, 12 ) UNION ALL SELECT :B8 , 
  TC.STATIC_ID AS STATIC_IDS, TO_CHAR(NULL) AS SECONDARY_STATIC_IDS, TC.ID 
  FROM WWV_FLOW_PAGE_PLUG_TEMPLATES TC WHERE TC.FLOW_ID = :B2 AND 
  TC.SECURITY_GROUP_ID IN ( :B1 , 11, 12 ) UNION ALL SELECT :B9 , 
  TC.STATIC_ID AS STATIC_IDS, TO_CHAR(NULL) AS SECONDARY_STATIC_IDS, TC.ID 
  FROM WWV_FLOW_ROW_TEMPLATES TC WHERE TC.FLOW_ID = :B2 AND 
  TC.SECURITY_GROUP_ID IN ( :B1 , 11, 12 ) UNION ALL SELECT :B10 , 
  TC.STATIC_ID AS STATIC_IDS, TO_CHAR(NULL) AS SECONDARY_STATIC_IDS, TC.ID 
  FROM WWV_FLOW_POPUP_LOV_TEMPLATE TC WHERE TC.FLOW_ID = :B2 AND 
  TC.SECURITY_GROUP_ID IN ( :B1 , 11, 12 ) UNION ALL SELECT :B11 , 
  TC.STATIC_ID AS STATIC_IDS, TO_CHAR(NULL) AS SECONDARY_STATIC_IDS, TC.ID 
  FROM WWV_FLOW_TEMPLATES TC WHERE TC.FLOW_ID = :B2 AND TC.SECURITY_GROUP_ID 
  IN ( :B1 , 11, 12 ) UNION ALL SELECT :B12 , TC.STATIC_ID AS STATIC_IDS, 
  TO_CHAR(NULL) AS SECONDARY_STATIC_IDS, TC.ID FROM WWV_FLOW_THEME_STYLES TC 
  WHERE TC.FLOW_ID = :B2 AND TC.SECURITY_GROUP_ID IN ( :B1 , 11, 12 ) UNION 
  ALL SELECT :B13 , TC.TEMPLATE_TYPES AS STATIC_IDS, TC.STATIC_ID AS 
  SECONDARY_STATIC_IDS, TC.ID FROM WWV_FLOW_TEMPLATE_OPT_GROUPS TC WHERE 
  TC.FLOW_ID = :B2 AND TC.SECURITY_GROUP_ID IN ( :B1 , 11, 12 ) UNION ALL 
  SELECT :B15 , AT.APEXLANG_NAME || :B14 || P.PLUGIN_TYPE AS STATIC_IDS, NULL 
  || :B14 || P.APEXLANG_NAME AS SECONDARY_STATIC_IDS, AT.ID FROM 
  WWV_FLOW_PLUGIN_ACT_TEMPLATES AT, WWV_FLOW_PLUGINS P WHERE AT.FLOW_ID = :B2 
  AND AT.SECURITY_GROUP_ID IN ( :B1 , 11, 12 ) AND P.ID = AT.PLUGIN_ID AND 
  P.SECURITY_GROUP_ID = AT.SECURITY_GROUP_ID AND P.THEME_ID IS NOT NULL UNION 
  ALL SELECT :B16 , AP.APEXLANG_NAME || :B14 || P.PLUGIN_TYPE AS STATIC_IDS, 
  NULL || :B14 || P.APEXLANG_NAME AS SECONDARY_STATIC_IDS, AP.ID FROM 
  WWV_FLOW_PLUGIN_ACT_POSITIONS AP, WWV_FLOW_PLUGINS P WHERE AP.FLOW_ID = :B2 
  AND AP.SECURITY_GROUP_ID IN ( :B1 , 11, 12 ) AND P.ID = AP.PLUGIN_ID AND 
  P.SECURITY_GROUP_ID = AP.SECURITY_GROUP_ID AND P.THEME_ID IS NOT NULL ) C


