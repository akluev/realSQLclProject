WITH SUBSCRIPTIONS AS ( SELECT COMPONENT_TYPE, COMPONENT_ID, REFERENCE_ID, 
  MASTER_FLOW_ID AS REFERENCE_FLOW_ID FROM WWV_FLOW_SUBSCRIBED_COMPONENTS S 
  WHERE S.SECURITY_GROUP_ID = :B2 AND S.FLOW_ID = :B1 ), COMPS AS ( SELECT 
  DISTINCT REFERENCE_FLOW_ID AS FLOW_ID, COMPONENT_TYPE, REFERENCE_ID AS 
  COMPONENT_ID FROM SUBSCRIPTIONS WHERE REFERENCE_FLOW_ID IS NOT NULL UNION 
  SELECT DISTINCT :B1 AS FLOW_ID, COMPONENT_TYPE COMPONENT_TYPE_NAME, 
  COMPONENT_ID FROM SUBSCRIPTIONS ) SELECT PE.TABLE_NAME, PE.ID 
  COMPONENT_TYPE_ID, C.COMPONENT_TYPE AS COMPONENT_TYPE_NAME, C.COMPONENT_ID, 
  C.FLOW_ID FROM COMPS C, WWV_PE_COMPONENT_TYPES PE, 
  WWV_FLOW_APPL_COMPONENT_TYPES CT WHERE PE.NAME = CT.PE_TYPE_NAME AND 
  C.COMPONENT_TYPE != 'THEME' AND CT.TYPE_NAME NOT IN ('WEB_SERVICE', 
  'TEMPLATE_COMPONENT') AND CT.TYPE_NAME = C.COMPONENT_TYPE UNION ALL SELECT 
  'WWV_FLOW_THEMES' AS TABLE_NAME, 2000 AS COMPONENT_TYPE_ID, 
  C.COMPONENT_TYPE COMPONENT_TYPE_NAME, C.COMPONENT_ID, C.FLOW_ID FROM COMPS 
  C WHERE C.COMPONENT_TYPE = 'THEME'


