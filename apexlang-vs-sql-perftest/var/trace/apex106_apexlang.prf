select id,       static_ids,       case when replace( secondary_static_ids, 
  chr(2) ) is not null then           secondary_static_ids       end as 
  secondary_static_ids,       page_id,       theme_static_id,       flow_id  
from
 (select c.id,       c.static_id  || chr(2) ||  p1.static_id || chr(2) ||  
  p2.static_id as static_ids,       c.secondary_static_id || chr(2) ||  
  p1.secondary_static_id || chr(2) ||  p2.secondary_static_id as 
  secondary_static_ids,       c.page_id,null as theme_static_id,       
  c.flow_id  from ( select id,"STATIC_ID" as static_id,null as 
  secondary_static_id,"PAGE_ID" as page_id,null as theme_id,       flow_id,   
      security_group_id,"INTERACTIVE_GRID_ID" as parent_fk_col  from 
  "WWV_FLOW_IG_REPORTS_V" tbl where security_group_id in ( :security_group_id,
   11, 12 ) and "FLOW_ID" = :FLOW_ID and  visibility in ('PRIMARY',
  'ALTERNATIVE')  ) c, ( select "ID" as pk_column,"STATIC_ID" as static_id, 
