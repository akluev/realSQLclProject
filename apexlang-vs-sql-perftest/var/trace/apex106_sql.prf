   L$.SECURITY_GROUP_ID AND T.FLOW_ID = L$.FLOW_ID AND T.FLOW_ID = :B1 AND 
  T.TO_ACTIVITY_ID = NA.ID AND T.FROM_ACTIVITY_ID = A.ID AND ROWNUM = 1) 
