SQL ID: 6zuzwsfugb3kd Plan Hash: 3682997957

SELECT /*+ result_cache */ A.ID, A.ATTRIBUTE_SEQUENCE, A.STATIC_ID, 
  A.DEFAULT_VALUE, A.SAMPLE_DATA_VALUE, NULL AS VALUE, CASE WHEN 
  A.ATTRIBUTE_TYPE = 'CHECKBOX' THEN 'Y' ELSE A.IS_REQUIRED END AS 
  IS_REQUIRED, A.ATTRIBUTE_TYPE, A.DEPENDING_ON_ATTRIBUTE_ID, 
  A.DEPENDING_ON_CONDITION_TYPE, A.DEPENDING_ON_EXPRESSION, 
  A.DEPENDING_ON_HAS_TO_EXIST, A.ATTRIBUTE_SCOPE, A.DEPRECATED_VALUES, 'Y' AS 
  IS_VISIBLE 
FROM
 WWV_FLOW_PLUGINS P, WWV_FLOW_PLUGIN_ATTR_GROUPS AG, 
  WWV_FLOW_PLUGIN_ATTRIBUTES A WHERE ( ( :B11 LIKE 'NATIVE\_%' ESCAPE '\' AND 
  ( P.FLOW_ID, P.SECURITY_GROUP_ID ) IN ( ( 4411, 10 ) ) ) OR ( :B11 NOT LIKE 
  'NATIVE\_%' ESCAPE '\' AND ( P.FLOW_ID, P.SECURITY_GROUP_ID ) IN ( ( :B1 , 
  :B2 ), ( :B3 , :B4 ) ) ) ) AND P.PLUGIN_TYPE = :B7 AND P.NAME = :B10 AND ( 
  A.SUPPORTED_COMPONENT_TYPES IS NULL OR :B8 = 'APPLICATION' OR ':' || 
  A.SUPPORTED_COMPONENT_TYPES || ':' LIKE '%:' || :B9 || ':%' ) AND 
  A.PLUGIN_ID = P.ID AND A.SECURITY_GROUP_ID = P.SECURITY_GROUP_ID AND ( 
  A.ATTRIBUTE_SCOPE = :B8 OR :B7 = CASE WHEN :B6 = 'N' THEN :B5 END ) AND 
  AG.PLUGIN_ID (+) = P.ID AND AG.SECURITY_GROUP_ID (+) = A.SECURITY_GROUP_ID 
  AND AG.ID (+) = A.ATTRIBUTE_GROUP_ID ORDER BY AG.DISPLAY_SEQUENCE ASC NULLS 
  FIRST, AG.ID, A.DISPLAY_SEQUENCE ASC, A.ID


