  WWV_FLOW_WORKFLOW_ACTIVITIES NA, WWV_FLOW_WORKFLOW_ACTIVITIES A, 
  WWV_FLOW_WORKFLOW_TRANSITIONS T, WWV_FLOW_WORKFLOW_ACTIVITIES$ NA$, 
  WWV_FLOW_WORKFLOW_ACTIVITIES$ A$ 
WHERE
 NA$.SECURITY_GROUP_ID = NA.SECURITY_GROUP_ID AND NA$.FLOW_ID = NA.FLOW_ID 
  AND NA$.WORKFLOW$_ID = A$.WORKFLOW$_ID AND NA$.WORKFLOW$_ID = 
  L$.WORKFLOW$_ID AND NA$.ACTIVITY_ID = NA.ID AND NA$.PREVIOUS_ID = A$.ID AND 
  NA$.ID = L$.CURRENT_ACTIVITY$_ID AND A$.SECURITY_GROUP_ID = 
  T.SECURITY_GROUP_ID AND A$.FLOW_ID = T.FLOW_ID AND A$.ACTIVITY_ID = A.ID 
  AND NA.SECURITY_GROUP_ID = A.SECURITY_GROUP_ID AND NA.FLOW_ID = A.FLOW_ID 
  AND A.SECURITY_GROUP_ID = A$.SECURITY_GROUP_ID AND A.FLOW_ID = A$.FLOW_ID 
