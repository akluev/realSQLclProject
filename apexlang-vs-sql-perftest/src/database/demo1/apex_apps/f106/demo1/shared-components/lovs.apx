            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column ICON_CLASS (
        heading {
            heading: Icon Class
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

    column R (
