page 100 (
    name: Old Home (backup)
    alias: OLD-HOME-BACKUP
    title: Old Home (backup)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region emp-dept-mini-hub (
        name: EMP & DEPT Mini Hub
        type: staticContent
        source {
            htmlCode: Minimal internal app for managing employees and departments in DEMO1.
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region page-navigation (
        name: Page Navigation
        type: list
        source {
            list: @navigation-menu
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                u-colors
                t-Cards--featured t-Cards--block force-fa-lg
                t-Cards--displayIcons
                t-Cards--4cols
                t-Cards--hideBody
                t-Cards--animColorFill
            ]
        }
    )

)

